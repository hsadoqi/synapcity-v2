{
  "name": "synapcity",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build --filter=storybook",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:storybook": "turbo run dev --filter=storybook",
    "lint": "turbo run lint",
    "format": "prettier --write . --cache=.prettiercache",
    "format:check": "prettier --check . --cache=.prettiercache",
    "typecheck": "turbo run check-types",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps && pnpm brand:check && pnpm build",
    "deps": "knip",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "prepare": "git config core.hooksPath .githooks || echo 'git hooks not activated (not a git checkout)'",
    "ui:add": "pnpm dlx shadcn@latest add -c apps/web"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2",
    "knip": "^6.38.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
