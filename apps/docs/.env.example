# Parent domain shared by the deployed web and docs hosts. Use the same value
# in both production builds only after exact sibling custom domains are attached
# and verified (for example app.example.com and docs.example.com -> .example.com).
# Leave empty for localhost and preview deployments; vercel.app is a public
# suffix and cannot be a shared cookie parent.
NEXT_PUBLIC_PREFERENCES_COOKIE_DOMAIN=
