# Copy to .env.local (git-ignored) and fill in. See the Environment variables
# table in apps/web/README.md. Only the publishable key belongs here: never the
# secret or service-role key.

# Supabase project URL and publishable key (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public origin of this app, used to build email and OAuth redirect URLs. Must be
# on Supabase's redirect allow-list.
SITE_URL=http://localhost:8080
