# Copy to .env.local (git-ignored) and fill in. See the Environment variables
# table in apps/web/README.md. Only the publishable key belongs here: never the
# secret or service-role key.

# Supabase project URL and publishable key (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public origin of this app, used to build email and OAuth redirect URLs. The
# value is an origin only: no path, no trailing slash needed.
#
# Each environment needs its own value, and each value must be on the Supabase
# redirect allow-list (Authentication > URL Configuration > Redirect URLs).
# Enter it as <SITE_URL>/auth/callback** : the app adds ?next=...&flow=... to the
# callback, and ** is the documented match for "any characters".
#
#   local       http://localhost:8080          (this value)
#   preview     the deployment's own URL, one exact entry per deployment
#   production  the production domain, once it is chosen
#
# Do not use a wildcard host such as *.vercel.app on the allow-list without the
# owner's approval (ADR-0006).
SITE_URL=http://localhost:8080

# Sentry project DSN (Project Settings > Client Keys). Optional: without it, no
# error reports are sent even when someone turns them on. Reports are sent only
# from browsers whose owner turned on Error reports in Settings > Data privacy.
NEXT_PUBLIC_SENTRY_DSN=

# Parent domain the shared look cookie is set on (for example .example.com), so
# the web and docs apps show the same look. Leave it empty for a host-only cookie,
# which is what local development and preview builds need. Set the same value in
# both apps. It is inlined at build time.
NEXT_PUBLIC_PREFERENCES_COOKIE_DOMAIN=
