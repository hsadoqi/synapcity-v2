{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8080",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "verify": "pnpm lint && pnpm check-types && pnpm build",
    "ui:add": "pnpm dlx shadcn@latest add",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@synapcity/domain-identity": "workspace:*",
    "@synapcity/domain-preferences": "workspace:*",
    "@synapcity/domain-records": "workspace:*",
    "@synapcity/domain-spaces": "workspace:*",
    "@synapcity/features-settings": "workspace:*",
    "@synapcity/features-spaces": "workspace:*",
    "@synapcity/frontend-collection": "workspace:*",
    "@synapcity/frontend-error-reports": "workspace:*",
    "@synapcity/frontend-forms": "workspace:*",
    "@synapcity/frontend-preferences": "workspace:*",
    "@synapcity/frontend-shells": "workspace:*",
    "@synapcity/frontend-site": "workspace:*",
    "@synapcity/frontend-ui": "workspace:*",
    "@synapcity/server-account": "workspace:*",
    "@synapcity/server-auth": "workspace:*",
    "@synapcity/server-supabase": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@synapcity/dev-eslint-config": "workspace:*",
    "@synapcity/dev-fixtures": "workspace:*",
    "@synapcity/dev-playwright-config": "workspace:*",
    "@synapcity/dev-typescript-config": "workspace:*",
    "@synapcity/dev-vitest-config": "workspace:*",
    "@synapcity/frontend-tailwind-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
