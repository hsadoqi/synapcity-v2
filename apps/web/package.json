{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8080",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "check-types": "next typegen && tsc --noEmit",
    "verify": "pnpm lint && pnpm check-types && pnpm build",
    "ui:add": "pnpm dlx shadcn@latest add",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@synapcity/frontend-site": "workspace:*",
    "@synapcity/frontend-ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@synapcity/dev-eslint-config": "workspace:*",
    "@synapcity/dev-playwright-config": "workspace:*",
    "@synapcity/dev-typescript-config": "workspace:*",
    "@synapcity/dev-vitest-config": "workspace:*",
    "@synapcity/frontend-tailwind-config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
