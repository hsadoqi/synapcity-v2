{
  "name": "storybook",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run",
    "test:storybook:watch": "vitest run --watch"
  },
  "dependencies": {
    "@synapcity/frontend-preferences": "workspace:*",
    "@synapcity/frontend-ui": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@synapcity/dev-eslint-config": "workspace:*",
    "@synapcity/dev-typescript-config": "workspace:*",
    "@synapcity/dev-vitest-config": "workspace:*",
    "@synapcity/frontend-tailwind-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "storybook": "10.6.3",
    "tailwindcss": "^4",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
