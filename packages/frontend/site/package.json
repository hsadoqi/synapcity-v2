{
  "name": "@synapcity/frontend-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./site": "./src/site.ts",
    "./metadata": "./src/metadata.ts",
    "./open-graph": "./src/open-graph.tsx"
  },
  "scripts": {
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "check-types": "tsc --noEmit",
    "verify": "pnpm lint && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@synapcity/dev-eslint-config": "workspace:*",
    "@synapcity/dev-typescript-config": "workspace:*",
    "@synapcity/dev-vitest-config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
