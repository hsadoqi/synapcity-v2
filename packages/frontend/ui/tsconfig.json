{
  "extends": "@synapcity/dev-typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/ui/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/next/*": ["./src/next/*"],
      "@/lib/*": ["./src/lib/*"]
    },
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".turbo"]
}
