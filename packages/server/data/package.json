{
  "name": "@synapcity/server-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
