  "dependencies": {
    "@synapcity/domain-records": "workspace:*",
    "@synapcity/domain-spaces": "workspace:*",
    "@synapcity/server-supabase": "workspace:*",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@synapcity/dev-eslint-config": "workspace:*",
    "@synapcity/dev-typescript-config": "workspace:*",
    "@synapcity/dev-vitest-config": "workspace:*",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
