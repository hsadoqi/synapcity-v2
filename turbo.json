{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["SITE_URL", "SYNAPCITY_DEV_AUTH"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "storybook-static/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "dev:docs": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "verify": {
      "dependsOn": ["lint", "typecheck", "deps", "build", "brand:check"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "brand:check": {
      "dependsOn": ["^brand:check"],
      "outputs": []
    },
    "deps": {
      "dependsOn": ["^deps"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit", "@synapcity/dev-vitest-config#build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit", "@synapcity/dev-vitest-config#build"],
      "outputs": ["**/coverage/report/**"]
    },
    "web#test:coverage": {
      "dependsOn": ["transit", "@synapcity/dev-vitest-config#build"],
      "outputs": ["**/coverage/report/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "web#test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "storybook#test:storybook": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
