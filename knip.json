{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "apps/web/src/lib/**/*",
    "tsconfig.json",
    "packages/dev/**/*",
    "docs/engineering/verification-records/**/*"
  ],
  "ignoreIssues": {
    "packages/server/supabase/src/database-types/database.types.ts": [
      "exports",
      "types"
    ]
  },
  "ignoreDependencies": [],
  "workspaces": {
    "apps/web": {
      "entry": ["playwright.local-session.config.ts"]
    },
    "packages/frontend/tailwind-config": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/server/data": {
      "entry": [
        "src/**/*.dbtest.ts",
        "vitest.db.config.ts",
        "src/**/*.budget.ts",
        "vitest.budgets.config.ts"
      ]
    }
  },
  "ignoreBinaries": ["psql"]
}
